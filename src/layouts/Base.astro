---
/**
 * Page shell for both locales.
 *
 * Carries the things the prototype had no way to express: a correct `lang` on
 * the document, hreflang pointing at the other locale, a canonical URL, and
 * LocalBusiness structured data built only from facts that are actually known.
 */
import { site, L } from '../config/site.js'
import '../../styles.css'
import '../../ui_kits/website/site.css'
import '../styles/production.css'

const { lang = 'en', title, description } = Astro.props

// Canonical and hreflang must name the URL a visitor can actually open, which
// on a project Pages site includes the /kalaylas-cleaning/ subpath. Astro.site
// and BASE_URL both come from astro.config.mjs, so moving to a custom domain
// later changes these without touching this file.
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const abs = (p) => new URL(`${base}${p}`, Astro.site).href

const canonical = abs(lang === 'en' ? '/' : '/es/')
const alternates = [
  { hreflang: 'en', href: abs('/') },
  { hreflang: 'es', href: abs('/es/') },
  { hreflang: 'x-default', href: abs('/') },
]

/**
 * Her published rates, flattened for the structured data below. Empty when
 * pricing has not been filled in, which drops every price-bearing field rather
 * than emitting a catalogue with nothing in it.
 */
const offers = site.pricing ? [...site.pricing.residential, ...site.pricing.commercial] : []

/** One schema.org Offer per service, priced exactly as the booking page prices it. */
const toOffer = (p) => ({
  '@type': 'Offer',
  itemOffered: {
    '@type': 'Service',
    name: (p[lang] ?? p.en).name,
    serviceType: L(lang, 'Cleaning service', 'Servicio de limpieza'),
  },
  priceCurrency: site.pricing.currency,
  // A tier marked `from` is a floor, so it is expressed as a minimum rather
  // than as a fixed price a customer could hold us to.
  ...(p.from
    ? {
        priceSpecification: {
          '@type': 'PriceSpecification',
          minPrice: p.price,
          priceCurrency: site.pricing.currency,
        },
      }
    : { price: p.price }),
})

/**
 * schema.org HouseCleaningService, built from site.js.
 *
 * Every optional field is omitted unless the data behind it is real. In
 * particular `aggregateRating` and `review` are emitted only when there are
 * genuine reviews: Google's structured-data policy treats invented review
 * markup as spam, and the FTC treats fake testimonials as deceptive.
 */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HouseCleaningService',
  name: site.name,
  description,
  url: canonical,
  areaServed: site.serviceArea.map((t) => ({
    '@type': 'City',
    name: t,
    address: { '@type': 'PostalAddress', addressRegion: site.region, addressCountry: site.country },
  })),
  availableLanguage: [
    { '@type': 'Language', name: 'English', alternateName: 'en' },
    { '@type': 'Language', name: 'Spanish', alternateName: 'es' },
  ],
  ...(site.hours
    ? {
        openingHoursSpecification: [
          {
            '@type': 'OpeningHoursSpecification',
            dayOfWeek: site.hours.days,
            opens: site.hours.opens,
            closes: site.hours.closes,
          },
        ],
      }
    : {}),
  ...(offers.length
    ? {
        // The price band Google can surface next to the listing. Built from the
        // real rates rather than the conventional '$$' guess.
        priceRange: `$${Math.min(...offers.map((o) => o.price)).toLocaleString('en-US')}\u2013$${Math.max(
          ...offers.map((o) => o.price),
        ).toLocaleString('en-US')}`,
        hasOfferCatalog: {
          '@type': 'OfferCatalog',
          name: L(lang, 'Cleaning services', 'Servicios de limpieza'),
          itemListElement: [
            {
              '@type': 'OfferCatalog',
              name: L(lang, 'Home cleaning', 'Limpieza de casas'),
              itemListElement: site.pricing.residential.map(toOffer),
            },
            {
              '@type': 'OfferCatalog',
              name: L(lang, 'Office and commercial cleaning', 'Limpieza de oficinas y comercios'),
              itemListElement: site.pricing.commercial.map(toOffer),
            },
          ],
        },
      }
    : {}),
  ...(site.booking ? { potentialAction: { '@type': 'ReserveAction', target: site.booking } } : {}),
  ...(site.phone ? { telephone: site.phone.href } : {}),
  ...(site.email ? { email: site.email } : {}),
  ...(site.address ? { address: { '@type': 'PostalAddress', ...site.address } } : {}),
  ...(site.social.googleBusiness ? { sameAs: [site.social.googleBusiness] } : {}),
  ...(site.rating
    ? {
        aggregateRating: {
          '@type': 'AggregateRating',
          ratingValue: site.rating.value,
          reviewCount: site.rating.count,
        },
      }
    : {}),
}
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'es' ? 'es_US' : 'en_US'} />
    <meta property="og:site_name" content={site.name} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skiplink" href="#main">{L(lang, 'Skip to content', 'Saltar al contenido')}</a>
    <slot />
  </body>
</html>
